{
  "name": "restaurant-ai-platform",
  "version": "0.8.0",
  "private": true,
  "description": "Multi-tenant AI customer-service backend for restaurants",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude 'tests/integration/**'",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/integration",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed.ts",
     "db:reset": "node --env-file-if-exists=.env --import tsx src/scripts/reset.ts",
    "provision:restaurant": "node --env-file-if-exists=.env --import tsx src/scripts/provision.ts restaurant",
    "provision:staff": "node --env-file-if-exists=.env --import tsx src/scripts/provision.ts staff",
    "provision:settings": "node --env-file-if-exists=.env --import tsx src/scripts/provision.ts settings",
    "provision:file": "node --env-file-if-exists=.env --import tsx src/scripts/provisionFile.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "provision:prod": "node dist/scripts/provision.js",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "openai": "^7.30.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
